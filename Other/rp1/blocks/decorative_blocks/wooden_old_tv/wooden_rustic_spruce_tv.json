{
  "format_version": "1.21.30",
  "minecraft:block": {
    "description": {
      "identifier": "ff:wooden_rustic_spruce_tv",
      "menu_category": {
        "category": "items"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ]
        }
      },
      "states": {
        "ff:channels": [1, 2, 3, 4],
        "ff:tv_on": [false, true]
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 0, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": { "rotation": [0, -90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },

      {
        "condition": "q.block_state('ff:tv_on') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": true,
              "face_dimming": true,
              "texture": "rustic_tv_spruce",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "off_channel",
              "render_method": "alpha_test"
            }
          }
        }
      },

      {
        "condition": "q.block_state('ff:tv_on') == true && q.block_state('ff:channels') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": true,
              "face_dimming": true,
              "texture": "rustic_tv_spruce",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "off_channel",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ff:tv_on') == true && q.block_state('ff:channels') == 1",
        "components": {
          "minecraft:light_emission": 11,
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": true,
              "face_dimming": true,
              "texture": "rustic_tv_spruce",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "weather_clear_channel",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ff:tv_on') == true && q.block_state('ff:channels') == 2",
        "components": {
          "minecraft:light_emission": 11,
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": true,
              "face_dimming": true,
              "texture": "rustic_tv_spruce",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "weather_rain_channel",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ff:tv_on') == true && q.block_state('ff:channels') == 3",
        "components": {
          "minecraft:light_emission": 11,
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": true,
              "face_dimming": true,
              "texture": "rustic_tv_spruce",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "weather_thunder_channel",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('ff:tv_on') == true && q.block_state('ff:channels') == 4",
        "components": {
          "minecraft:light_emission": 11,
          "minecraft:material_instances": {
            "*": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "plasma_tv_weather_snow",
              "render_method": "alpha_test"
            },
            "channel": {
              "ambient_occlusion": false,
              "face_dimming": false,
              "texture": "off_channel",
              "render_method": "alpha_test"
            }
          }
        }
      }
    ],
    "components": {
      "minecraft:tick": {
        "interval_range": [10, 10],
        "looping": true
      },
      "minecraft:geometry": {
        "identifier": "geometry.rustic_tv"
      },
      "tag:minecraft:is_pickaxe_item_destructible": {},
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -6],
        "size": [16, 12, 12]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -6],
        "size": [16, 12, 12]
      },
      "minecraft:custom_components": [
        "ff:single_interactive",
        "ff:tv_weather_channel"
      ],
      "minecraft:material_instances": {
        "*": {
          "ambient_occlusion": true,
          "face_dimming": true,
          "texture": "rustic_tv_spruce",
          "render_method": "alpha_test"
        },
        "channel": {
          "ambient_occlusion": false,
          "face_dimming": false,
          "texture": "off_channel",
          "render_method": "alpha_test"
        }
      }
    }
  }
}