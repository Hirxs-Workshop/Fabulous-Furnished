{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ff:coffee_drop",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"events": {
			"hit_ground": {
				"sound_effect": {
					"event_name": "cauldron_drip.water.pointed_dripstone"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 5,
				"max_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": 0.1,
				"direction": "outwards"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "variable.stuck_time = variable.particle_random_1 * 4 + 1;",
				"per_render_expression": "variable.stuck_time = variable.particle_random_1 * 4 + 1;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 10
			},
			"minecraft:particle_expire_if_not_in_blocks": ["ff:coffee_machine"],
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -3.5, 0],
				"linear_drag_coefficient": "variable.stuck_time = variable.particle_random_1 * 4 + 1;return variable.particle_age < variable.stuck_time ? 277 : 0.01;"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [8, 56],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"coefficient_of_restitution": 0.1,
				"collision_radius": 0.08,
				"events": [
					{
						"event": "hit_ground",
						"min_speed": 0.5
					}
				]
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [0.25098, 0.14118, 0.07451, 1]
			}
		}
	}
}