{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ff:coffee_explode_3",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/coffee_cup_shards"
			}
		},
		"events": {
			"hit_ground": {
				"sound_effect": {
					"event_name": "cauldron_drip.water.pointed_dripstone"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "variable.stuck_time = variable.particle_random_1 * 4 + 1;",
				"per_render_expression": "variable.stuck_time = variable.particle_random_1 * 4 + 1;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 3
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-360, 360)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -10, 0],
				"linear_drag_coefficient": 0.1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 0.3,
				"collision_radius": 0.2,
				"events": [
					{
						"event": "hit_ground",
						"min_speed": 0.5
					}
				]
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffffffff",
						"0.5": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}