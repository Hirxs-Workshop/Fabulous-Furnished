{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sd:orange_autumn_leaves",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/orange_autumn_leaves_particles"
			}
		},
		"events": {
			"splash2": {
				"particle_effect": {
					"effect": "sd:orange_autumn_leaves_ground",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "v.fall_acc = -0.3; v.wind_acc = 10; v.curve_len = 15;"
			},
			"minecraft:emitter_rate_manual": {
				"max_particles": 2000
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0.5, -0.075, 0.5],
				"half_dimensions": [0.5, 0, 0.5],
				"direction": [0, -0.021, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 15
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "minecraft:fern", "minecraft:short_grass", "minecraft:sweet_berry_bush", "minecraft:tall_grass", "minecraft:large_fern"],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-30, 30)"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.cos((v.particle_age / 15) * (1000 + v.particle_random_3 * 3000)) * v.wind_acc * (v.particle_age / 15)", "v.fall_acc", "math.sin((v.particle_age / 15) * (1000 + v.particle_random_3 * 3000)) * v.wind_acc * (v.particle_age / 15)"],
				"rotation_acceleration": "v.particle_random_4 > 0.5 ? -5 : 5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_1 > 0.5 ? 0.1 : 0.15", "v.particle_random_1 > 0.5 ? 0.1 : 0.15"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 12,
					"texture_height": 8,
					"uv": ["math.floor(v.particle_random_1 * 3) * 4", "math.floor(v.particle_random_2 * 2) * 4"],
					"uv_size": [4, 4]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 10,
				"collision_radius": 0.075,
				"expire_on_contact": true,
				"events": [
					{
						"event": "splash2",
						"min_speed": 0.3
					}
				]
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}