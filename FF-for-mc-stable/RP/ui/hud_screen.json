{
    "hud_screen": {
      "render_only_when_topmost": false,
      "$additional_screen_content": "hud.notification_factory",
      "$use_loading_bars": false,
      "$screen_animations": [],
      "$background_animations": []
    },
    "notification_factory": {
      "type": "stack_panel",
      "size": ["100%c", "100%c"],
      "layer": 20,
      "anchor_from": "left_middle",
      "anchor_to": "left_middle",
      "factory": {
        "name": "chat_item_factory",
        "control_ids": {"chat_item": "@hud.notification"}
      }
    },
    "noti_1": {
      "anim_type": "size",
      "duration": "$in_time",
      "easing": "out_sine",
      "from": [0, 0],
      "to": ["100%c", "100%c"],
      "next": "@hud.noti_2"
    },
    "noti_2": {
      "anim_type": "wait",
      "duration": "$stay_time",
      "next": "@hud.noti_3"
    },
    "noti_3": {
      "anim_type": "size",
      "duration": "$out_time",
      "easing": "in_sine",
      "from": ["100%c", "100%c"],
      "to": [0, "100%c"],
      "next": "@hud.noti_4"
    },
    "noti_4": {
      "anim_type": "alpha",
      "duration": 0,
      "from": 1,
      "to": 0,
      "next": "@hud.noti_5"
    },
    "noti_5": {
      "anim_type": "size",
      "duration": 1,
      "easing": "out_expo",
      "from": ["100%c", "100%c"],
      "to": ["100%c", 0],
      "next": "@hud.noti_4",
      "destroy_at_end": "chat_grid_item"
    },
    "immediate_destroy_anim": {
      "anim_type": "wait",
      "duration": 0,
      "destroy_at_end": "chat_grid_item"
    },
    "notification": {
      "$in_time": 1.5,
      "$stay_time": 5,
      "$out_time": 1,
      "type": "panel",
      "propagate_alpha": true,
      "anims": ["@hud.noti_1"],
      "controls": [
        {
          "notification_background": {
            "type": "image",
            "anchor_from": "top_right",
            "anchor_to": "top_right",
            "size": ["100%c + 18px", "100%cm + 12px"],
            "min_size": ["100%c + 18px", 34],
            "controls": [
              {
                "notification_text_panel": {
                  "type": "panel",
                  "size": ["100%cm", "100%c"],
                  "layer": 1,
                  "anchor_from": "right_middle",
                  "anchor_to": "right_middle",
                  "offset": [-9, 1],
                  "bindings": [
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "#notification_title",
                      "target_property_name": "#nested_title",
                      "resolve_sibling_scope": true
                    },
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "#notification_message",
                      "target_property_name": "#nested_message",
                      "resolve_sibling_scope": true
                    }
                  ],
                  "controls": [
                    {
                      "notification_title": {
                        "type": "label",
                        "line_padding": -2,
                        "text": "#title",
                        "anchor_from": "top_left",
                        "anchor_to": "top_left",
                        "offset": [0, -2],
                        "max_size": [200, "default"],
                        "bindings": [
                          {
                            "binding_type": "view",
                            "source_control_name": "notification_text_panel",
                            "source_property_name": "#nested_title",
                            "target_property_name": "#title",
                            "resolve_sibling_scope": true
                          },
                          {
                            "binding_type": "view",
                            "source_property_name": "(not (#title = '§r§r'))",
                            "target_property_name": "#visible"
                          }
                        ]
                      }
                    },
                    {
                      "notification_message": {
                        "type": "label",
                        "line_padding": 1,
                        "text": "#message",
                        "anchor_from": "bottom_left",
                        "anchor_to": "bottom_left",
                        "max_size": [200, "default"],
                        "bindings": [
                          {
                            "binding_type": "view",
                            "source_control_name": "notification_text_panel",
                            "source_property_name": "#nested_message",
                            "target_property_name": "#message",
                            "resolve_sibling_scope": true
                          },
                          {
                            "binding_type": "view",
                            "source_property_name": "(not (#message = '§r§r'))",
                            "target_property_name": "#visible"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "notification_icon_texture": {
                  "type": "image",
                  "layer": 1,
                  "size": [16, 16],
                  "anchor_from": "top_left",
                  "anchor_to": "top_left",
                  "offset": [9, 9],
                  "bindings": [
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "#notification_icon_texture",
                      "target_property_name": "#texture",
                      "resolve_sibling_scope": true
                    },
                    {
                      "binding_type": "view",
                      "source_property_name": "(not (#texture = '') and (#texture - 'aux:' = #texture))",
                      "target_property_name": "#visible"
                    }
                  ]
                }
              },
              {
                "notification_item_renderer": {
                  "type": "custom",
                  "renderer": "inventory_item_renderer",
                  "layer": 1,
                  "size": [16, 16],
                  "anchor_from": "top_left",
                  "anchor_to": "top_left",
                  "offset": [9, 9],
                  "bindings": [
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "((#notification_icon_texture - 'aux:') * 1)",
                      "target_property_name": "#item_id_aux",
                      "resolve_sibling_scope": true
                    },
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "(not (#notification_icon_texture - 'aux:' = #notification_icon_texture))",
                      "target_property_name": "#visible",
                      "resolve_sibling_scope": true
                    }
                  ]
                }
              },
              {
                "notification_icon_padding": {
                  "type": "panel",
                  "size": [6, 0],
                  "bindings": [
                    {
                      "binding_type": "view",
                      "source_control_name": "notification_background",
                      "source_property_name": "(not ((#notification_title + #notification_message = '§r§r§r§r') or (#notification_icon_texture = '')))",
                      "target_property_name": "#visible",
                      "resolve_sibling_scope": true
                    }
                  ]
                }
              }
            ],
            "bindings": [
              {
                "binding_type": "view",
                "source_property_name": "(not (('§␛' + #text + '§r') - ('§␛' + $notification_flag_0e34fd) = ('§␛' + #text + '§r')))",
                "target_property_name": "#visible"
              },
              {
                "binding_type": "view",
                "source_property_name": "('\b' + #text - $notification_flag_0e34fd)",
                "target_property_name": "#data"
              },
              {
                "binding_type": "view",
                "source_property_name": "('§r' + '%.101s' * #data - '\b' - '\t' + '§r')",
                "target_property_name": "#notification_title"
              },
              {
                "binding_type": "view",
                "source_property_name": "(('§r' + '%.301s' * #data - '%.101s' * #data) - '\b' - '\t' + '§r')",
                "target_property_name": "#notification_message"
              },
              {
                "binding_type": "view",
                "source_property_name": "('%.401s' * #data - '%.301s' * #data - '\t')",
                "target_property_name": "#notification_icon_texture"
              },
              {
                "binding_type": "view",
                "source_property_name": "('%.501s' * #data - '%.401s' * #data - '\t')",
                "target_property_name": "#texture"
              }
            ]
          }
        },
        {
          "immediate_destroy": {
            "type": "stack_panel",
            "size": [0, 0],
            "factory": {
              "name": "immediate_destroy_factory",
              "control_name": "@hud.immediate_destroy_control"
            },
            "bindings": [
              {
                "binding_type": "view",
                "source_control_name": "notification_background",
                "source_property_name": "((not #visible) * 1)",
                "target_property_name": "#collection_length",
                "resolve_sibling_scope": true
              }
            ]
          }
        }
      ]
    },
    "immediate_destroy_control": {
      "type": "panel",
      "size": [0, 0],
      "anims": ["@hud.immediate_destroy_anim"]
    },
    "chat_grid_item/chat_background": {
      "bindings": [
        {
          "binding_type": "view",
          "source_property_name": "(('§␛' + #text + '§r') - ('§␛' + $notification_flag_0e34fd) = ('§␛' + #text + '§r'))",
          "target_property_name": "#visible"
        }
      ]
    },

  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "(not (#text = #text))",
          "target_property_name": "#visible"
        }
      }
    ]
  },

	"hud_spacer": {
    "type": "panel",
    "layer": 31,
    "size": [8, 10]
  },

  "image": {
    "type": "image",
    "size": ["100% + 12px", "100% + 5px"],
    "layer": -1,
    "alpha": 0.7,
    "texture": "textures/ff_ui/default_ui"
  },

  "image2": {
    "type": "image",
    "size": ["100% + 12px", "100% + 5px"],
    "layer": -1,
    "alpha": 0.7,
    "texture": "textures/ff_ui/deny_ui"
  },

  "action_bar_control": {
    "type": "panel",
    "size": [0, 0],
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "action_bar_control_b": {
    "type": "panel",
    "size": [0, 0],
    "bindings": [
      { "binding_name": "#hud_title_text_string" },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "hud_text": {
    "$control": "",
    "$preserved": "",
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", "100%c"],
    "controls": [
      { "space_0@hud.hud_spacer": {} },
      {
        "preserved_title_display": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 31,
          "offset": ["6px", 0],
          "enable_profanity_filter": false,
          "text": "#text_0",
          "controls": [
            { "image@hud.image": {} }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$control",
              "source_property_name": "(('\u00a7z' + #preserved_text) - $preserved)",
              "target_property_name": "#text_0"
            }
          ]
        }
      },
      { "space_1@hud.hud_spacer": {} }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$control",
        "source_property_name": "(not (('b' + #preserved_text) - $preserved = 'b'))",
        "target_property_name": "#visible"
      }
    ]
  },

  "main_hud_1": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "offset": ["-0px", "6px"],
    "controls": [
      { "hud_text_0@hud.hud_text": { "$control": "action_bar_control_0", "$preserved": "$update_string_0" } },
      { "hud_text_1@hud.hud_text": { "$control": "action_bar_control_1", "$preserved": "$update_string_1" } },
      { "hud_text_2@hud.hud_text": { "$control": "action_bar_control_2", "$preserved": "$update_string_2" } },
      { "hud_text_3@hud.hud_text": { "$control": "action_bar_control_3", "$preserved": "$update_string_3" } },
      { "hud_text_4@hud.hud_text": { "$control": "action_bar_control_4", "$preserved": "$update_string_4" } }
    ]
  },

  "main_hud_2": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "offset": ["-0px", "6px"],
    "controls": [
      { "hud_text_0@hud.hud_text": { "$control": "action_bar_control_0_b", "$preserved": "$update_string_0" } },
      { "hud_text_1@hud.hud_text": { "$control": "action_bar_control_1_b", "$preserved": "$update_string_1" } },
      { "hud_text_2@hud.hud_text": { "$control": "action_bar_control_2_b", "$preserved": "$update_string_2" } },
      { "hud_text_3@hud.hud_text": { "$control": "action_bar_control_3_b", "$preserved": "$update_string_3" } },
      { "hud_text_4@hud.hud_text": { "$control": "action_bar_control_4_b", "$preserved": "$update_string_4" } }
    ]
  },

  "action_bar_control_0_b": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      { "image2@hud.image2": {} }
    ]
  },

	"panel_top_right": {
    "$update_string_0": "t_slot0",
    "$update_string_1": "t_slot1",
    "$update_string_2": "t_slot2",
    "$update_string_3": "t_slot3",
    "$update_string_4": "t_slot4",
    "type": "panel",
    "size": ["100%c", "100%c"],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [-3, 0],
    "controls": [
      { "action_bar_control_0@hud.action_bar_control": { "$update_string": "$update_string_0" } },
      { "action_bar_control_1@hud.action_bar_control": { "$update_string": "$update_string_1" } },
      { "action_bar_control_2@hud.action_bar_control": { "$update_string": "$update_string_2" } },
      { "action_bar_control_3@hud.action_bar_control": { "$update_string": "$update_string_3" } },
      { "action_bar_control_4@hud.action_bar_control": { "$update_string": "$update_string_4" } },
      {
        "sdb@hud.main_hud_1": {
          "anchor_from": "top_right",
          "anchor_to": "top_right"
        }
      }
    ]
  },

  "panel_bottom_right": {
    "$update_string_0": "b_slot0",
    "$update_string_1": "b_slot1",
    "$update_string_2": "b_slot2",
    "$update_string_3": "b_slot3",
    "$update_string_4": "b_slot4",
    "type": "panel",
    "size": ["100%c", "100%c"],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      { "action_bar_control_0_b@hud.action_bar_control_b": { "$update_string": "$update_string_0" } },
      { "action_bar_control_1_b@hud.action_bar_control_b": { "$update_string": "$update_string_1" } },
      { "action_bar_control_2_b@hud.action_bar_control_b": { "$update_string": "$update_string_2" } },
      { "action_bar_control_3_b@hud.action_bar_control_b": { "$update_string": "$update_string_3" } },
      { "action_bar_control_4_b@hud.action_bar_control_b": { "$update_string": "$update_string_4" } },
      {
        "sdb@hud.main_hud_2": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      }
    ]
  },

	"root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "panel_top_right@hud.panel_top_right": {} },
          { "panel_top_right@hud.panel_bottom_right": {} }
        ]
      }
    ]
  }
}