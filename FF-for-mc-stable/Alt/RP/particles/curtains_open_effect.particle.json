{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ff:curtains_open_effect",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/curtain_sparks"
			}
		},
		"curves": {
			"variable.color": {
				"type": "linear",
				"input": "v.particle_random_3",
				"horizontal_range": 1,
				"nodes": [1, 0, 1, 0]
			},
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age/v.particle_lifetime",
				"horizontal_range": 1,
				"nodes": [1, 1, 1, 0.95, 0.9, 0.83, 0.76, 0.59, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.2
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0.3, 0],
				"half_dimensions": [0.6, 0.6, 0.6],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.particle_random_1*1.5"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-360, 360)"
			},
			"minecraft:particle_initial_speed": 0.7,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "v.particle_age*1.75", 0],
				"linear_drag_coefficient": 3.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size*v.particle_random_1*0.16", "v.size*v.particle_random_1*0.16"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00797979",
						"0.27": "#B0797979",
						"0.75": "#B0666666",
						"1.0": "#00666666"
					}
				}
			}
		}
	}
}